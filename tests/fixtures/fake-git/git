#!/usr/bin/env bash
# Needs bash 3.2 and POSIX tools only.
set -euo pipefail

usage() {
  cat <<'EOF'
git, with some addresses swapped — runs the real git with every argument that equals a
mapped URL replaced by a local path, so a push "to GitHub" lands in a bare repository and
the address git computes from the configuration stays the real one.

  git ARGS...   the real git, with mapped arguments swapped; nothing else changes
  git help      this text

Environment: FAKE_GIT_MAP holds one "URL PATH" pair per line; FAKE_GIT_REAL is the real
git to run; FAKE_GIT_AFTER_LS_REMOTE, when set, is a command run right after every
ls-remote, the way somebody else's push lands between a read and a write.
Exit: whatever the real git exits with, 2 when FAKE_GIT_REAL is unset.
EOF
}

cmd="${1:-}"
case "$cmd" in
  -h | --help | help) usage ;;
  *) # pass-through
    [ -n "${FAKE_GIT_REAL:-}" ] || {
      echo "fake git: FAKE_GIT_REAL must name the real git" >&2
      exit 2
    }
    args=()
    for a in "$@"; do
      while IFS=' ' read -r url path; do
        [ -n "$url" ] || continue
        [ "$a" != "$url" ] || a=$path
      done <<<"${FAKE_GIT_MAP:-}"
      args+=("$a")
    done
    if [ -n "${FAKE_GIT_AFTER_LS_REMOTE:-}" ] && [[ " $* " == *" ls-remote "* ]]; then
      rc=0
      "$FAKE_GIT_REAL" ${args[@]+"${args[@]}"} || rc=$?
      bash -c "$FAKE_GIT_AFTER_LS_REMOTE"
      exit "$rc"
    fi
    exec "$FAKE_GIT_REAL" ${args[@]+"${args[@]}"}
    ;;
esac
